<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      UI tests (Ui/): the window's sources are compiled in, so the tests need no reference to the exe.
      Program.cs (the entry point) and RenderUi.cs (the Debug-only renderer) stay out.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);QUIETHOSTS_UI_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QuietHosts.Core\QuietHosts.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\QuietHosts\*.cs" Exclude="..\..\src\QuietHosts\Program.cs;..\..\src\QuietHosts\RenderUi.cs" LinkBase="Ui\Linked" />
    <EmbeddedResource Include="..\..\src\QuietHosts\QuietHosts.ico" LogicalName="QuietHosts.Icon.ico" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="QuietHosts.LICENSE.txt" Condition="Exists('..\..\LICENSE')" />
  </ItemGroup>
</Project>
